# Stripe (checkout for shop items + tip jar)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Printful (product catalog + order fulfillment)
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=

# Supabase (original art gallery listings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kit, formerly ConvertKit (email list / free coloring page opt-in).
# Not currently used in code — the site uses Kit's own embed widget instead
# (src/components/KitEmbedForm.tsx), since Kit's free plan blocks
# third-party apps from writing subscribers via the API. Keep these set if
# you have them; they're only needed again if upgrading to a paid Kit plan
# and switching back to a site-styled form that posts to the API directly.
KIT_API_KEY=
KIT_FORM_ID=

# Resend (contact form email delivery)
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
